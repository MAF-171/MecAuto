# Copia este archivo como  backend/.env.local  (está en .gitignore) y completa los valores.
# NO escribas contraseñas reales en este archivo de ejemplo.

# Conexión a SQL Server (ver README: cómo averiguar instancia y puerto)
MECAUTO_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=MECAUTO;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=false
MECAUTO_DB_USER=mecauto_app
MECAUTO_DB_PASSWORD=CAMBIA_ESTA_CLAVE

# Secreto para firmar los tokens (mínimo 32 caracteres aleatorios)
MECAUTO_JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_DE_MAS_DE_32_CARACTERES

# Primer administrador: se crea UNA sola vez, solo si la tabla usuario está vacía.
MECAUTO_ADMIN_USER=admin
MECAUTO_ADMIN_PASSWORD=ELIGE_UNA_CLAVE_FUERTE_DE_12_O_MAS_CARACTERES
MECAUTO_ADMIN_NOMBRE=Administrador

# Origen del frontend permitido por CORS
MECAUTO_CORS_ORIGENES=http://localhost:5173
